<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device-to-device transfer: the connection
     log, captures, rules and the encrypted proxy password stay here (allowBackup=false alone does
     not cover device transfer on Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
